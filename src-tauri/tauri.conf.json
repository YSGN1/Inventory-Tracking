{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stok Takip",
  "version": "0.1.0",
  "identifier": "com.guney.stoktakip",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Stok Takip",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --lang=tr"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Stok Takip",
    "copyright": "© 2026 Stok Takip katkıda bulunanları — MIT Lisansı",
    "shortDescription": "Stok takip programı",
    "windows": {
      "nsis": {
        "languages": [
          "Turkish"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExRDJGNTU2M0JEMzQ0REIKUldUYlJOTTdWdlhTRVFhOGhwRzlZK1JaWHRvdFM5OC9ZUFlyeFNCc0t4MUxUUkdVUG1PbWNra04K",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
